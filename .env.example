# pnpm env:init 仅在 .env 不存在时创建配置和随机初始化密钥。
NODE_ENV=development
WEB_ORIGIN=http://127.0.0.1:8730
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8730
API_PORT=8731
DATA_DIR=./data
SETUP_TOKEN=
SESSION_TTL_SECONDS=2592000
LOGIN_RATE_LIMIT=10
SUBMIT_PROJECT_RATE_LIMIT=5
SUBMIT_IP_RATE_LIMIT=30
IMAGE_CONCURRENCY=2
ATTACHMENT_CAPACITY_BYTES=1073741824
# 仅填写明确可信的直接代理 IP；容器部署按实际 Docker 网关调整。
TRUSTED_PROXY_IPS=127.0.0.1,::1
